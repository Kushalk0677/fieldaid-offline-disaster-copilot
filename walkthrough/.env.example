# Ollama server address (Gemma 4 model runs here, outside the container)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# SQLite database path (relative or absolute)
FIELDAID_DB_PATH=data/fieldaid.sqlite

# Runtime cache directory for YOLO, torch, and temporary artifacts
FIELDAID_RUNTIME_CACHE=./runtime_cache
